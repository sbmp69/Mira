generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id            String         @id @default(uuid())
  email         String?        @unique
  name          String?
  country       String?
  languagePref  String?        @default("Auto")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
  memories      Memory[]
}

model Companion {
  id            String         @id @default(uuid())
  name          String
  avatar        String?
  description   String?
  personality   String
  speakingStyle String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
}

model Conversation {
  id                String    @id @default(uuid())
  userId            String
  companionId       String
  relationshipStage Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id])
  companion Companion @relation(fields: [companionId], references: [id])
  messages  Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  sender         String
  content        String
  image          String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
}

model Memory {
  id         String                       @id @default(uuid())
  userId     String
  content    String
  type       String
  importance String
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                     @default(now())
  user       User                         @relation(fields: [userId], references: [id])
}
